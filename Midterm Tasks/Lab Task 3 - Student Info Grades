import java.util.Scanner;
public class StudentGradeMan{

    public static void studInfo(String num, String name, String course, String year){
        System.out.println("----------------------------------");
        System.out.printf("Student Number : %s%n ", num);
        System.out.printf("Student Name : %s%n ", name);
        System.out.printf("Course : %s%n", course);
        System.out.printf("Year level : %s%n", year);
        System.out.println("----------------------------------");
    }




    public static String getEquiv(double ave, char choice)
    {
        String result = "";
        switch(choice)
        {
            case 'L': case 'l':
            {
                if(ave >= 90)
                {
                    result = "A";
                } else if (ave >= 83){
                    result = "B";
                } else if (ave >= 75) {
                    result = "C";
                } else if ( ave >= 60){
                    result = "D";
                } else {
                    result = "F";
                }
			.
				break; 
            }
			
            case 'N':case 'n':

                if(ave >= 96)
                {
                    result = "4.00";
                } else if (ave >= 90){
                    result = "3.50";
                } else if (ave >= 84) {
                    result = "3.00";
                } else if ( ave >= 77){
                    result = "2.00";
                } else {
                    result = "1.00";
                }
				break;

            default:
                result = "No Match!";
				break;
            }
            return result;
        }

        public static void main(String[] args) {
            Scanner sc = new Scanner(System.in);
            System.out.print("Student Number: ");
            String num = sc.nextLine();
            System.out.print("Student Name: ");
            String name = sc.nextLine();
            System.out.print("Course: ");
            String course = sc.nextLine();
            System.out.print("Year Level: ");
            String year = sc.nextLine();

            System.out.println("--------------------------------");
            System.out.println();

        

            System.out.println("Enter Grades: ");
            System.out.printf("Grade 1 \t: ");
            double g1 = sc.nextDouble();
            System.out.printf("Grade 2 \t: ");
            double g2 = sc.nextDouble();
            System.out.printf("Grade 3 \t: ");
            double g3 = sc.nextDouble();

            double ave = (g1 + g2 + g3) / 3;

            System.out.println("--------------------------------");
            System.out.println();


            System.out.print("Display Letter Grade or Numeric [L|N]? ");
            char choice = sc.next().charAt(0);
            
            String equiv = getEquiv(ave, choice);

            System.out.println("--------------------------------");
            System.out.println("Student Details: " + num + " " + course + " " + year);
            System.out.println("Full Name: " + name);
            System.out.println("--------------------------------");
            System.out.printf("Average is \t: %.2f%n", ave);
            if(choice == 'L' || choice == 'l') {
                System.out.println("Letter Grade is: " + equiv);
            } else if (choice == 'N' || choice == 'n') {
                System.out.println("Numeric Grade is: " + equiv);
            } else {
                System.out.println(equiv);
            }
            System.out.println("Remarks         : " + (ave >= 60 ? "Passed" : "Failed"));
            System.out.println("--------------------------------");



        }
    }

